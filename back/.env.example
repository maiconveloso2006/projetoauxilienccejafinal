# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3600

# ── Identificador de ambiente ─────────────────────────────────────────────────
# O Vercel define VERCEL=1 automaticamente. Não defina isso manualmente.
# VERCEL=1

# ── Banco de dados ────────────────────────────────────────────────────────────
# Use "sqlite" para desenvolvimento local sem instalação extra
# Use "mysql"  para produção (Vercel + PlanetScale, Railway, etc.)

DB_TYPE=sqlite
SQLITE_DB_PATH=auxilioencceja.sqlite

# Descomente e preencha abaixo para usar MySQL em produção:
# DB_TYPE=mysql
# DB_HOST=seu-host-mysql
# DB_PORT=3306
# DB_USER=seu-usuario
# DB_PASSWORD=sua-senha
# DB_DATABASE=auxilioencceja
